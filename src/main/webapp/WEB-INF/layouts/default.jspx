<html xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:tiles="http://tiles.apache.org/tags-tiles"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:util="urn:jsptagdir:/WEB-INF/tags/util">

<jsp:output doctype-root-element="HTML"	doctype-system="about:legacy-compat" />
<jsp:directive.page contentType="text/html;charset=UTF-8" />
<jsp:directive.page pageEncoding="UTF-8" />

<head>
	<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;200;300;400&amp;display=swap" rel="stylesheet"/>
	<meta name="google-site-verification" content="krCjecjKCEH5vm3gw9EkIamJ3DNwy3YROHGQe8ty-ks" />
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<meta http-equiv="X-UA-Compatible" content="IE=10" />
	
	<util:load-headers />
	
	<title><spring:message code="welcome_titlepane"
			arguments="${app_name}" /></title>
	
	<!-- Global site tag (gtag.js) - Google Analytics -->
	<script async="async" src="https://www.googletagmanager.com/gtag/js?id=UA-198130192-1">
	</script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', '${app_ga}');
	</script>

	<style>
		body {
			font-family: 'Roboto', sans-serif !important;
			font-weight: 200;
			background-color: #f9f9f9;
			color: #333;
		}
		h1, h2, h3 {
			font-weight: 200; /* Bold for headings */
		}
		ul.navbar-nav li a {
			font-family: 'Roboto', sans-serif !important;
			font-weight: 200 !important;
		}
	</style>
</head>

<body style="background-color: #${background_app}; color:#${foreground_app}">
	<util:changeImg position="bg_1"/>
	<tiles:insertAttribute name="header" ignore="true" />
	<div id="main" style="z-index: 1">
		<tiles:insertAttribute name="body" />
	</div>
	<tiles:insertAttribute name="footer" ignore="true" />
	<util:contentEditor />
	<util:qrCode/>
		
	<util:load-scripts />
	<c:if test="${'true' eq debugFlag}">
		${debugInfo}
	</c:if>
</body>
</html>

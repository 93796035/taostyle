<div xmlns:spring="http://www.springframework.org/tags"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:util="urn:jsptagdir:/WEB-INF/tags/util"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:page="urn:jsptagdir:/WEB-INF/tags/form"
	xmlns:table="urn:jsptagdir:/WEB-INF/tags/form/fields"
	xmlns:field="urn:jsptagdir:/WEB-INF/tags/form/fields"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions" version="2.0">
	<jsp:directive.page contentType="text/html;charset=UTF-8" />
	<jsp:output omit-xml-declaration="yes" />

	<spring:url value="/resources/css/blueimp-gallery.min.css"
		var="blueimp_gallery" />
	<link rel="stylesheet" href="${blueimp_gallery}" />

	<!-- don't display by default -->
	<c:set value=" col-xs-12 col-sm-12 col-md-12 col-lg-12" var="span" />
	
	<c:set value="0px" var="leftmargin" />
	
	<!-- if have menu, then display-->
	<c:if test="${not empty subMenu and 'true' eq leftbar_fixed}">
		<c:set value=" col-xs-${service_width_xs} col-sm-${service_width_sm} col-md-${service_width_md} col-lg-${service_width_lg} col-xl-${service_width_xl}
		 col-sm-offset-${12-service_width_sm} col-md-offset-${12-service_width_md} col-lg-offset-${12-service_width_lg} col-xl-offset-${12-service_width_xl}" var="span" />
		<c:set value="20px" var="leftmargin" />
	</c:if>
	  	
	<c:set var="isAboveManager"  value="false" />
	<c:if test="${user_role == '[ROLE_ADMIN]'  or user_role == '[ROLE_MANAGER]'}">
		<c:set var="isAboveManager"  value="true" />
	</c:if>
	
	<!-- Main Content -->
	<c:if test="${user_role == '[ROLE_ADMIN]'}" >
		<div class="content ${span}" style="color:#${background_foot}; margin-left:${leftmargin}; padding:20px; 
		background:#${background_subpage}; opacity:${subpage_opacity}; float:right">
			<div style="position:relative; display:inline-block; width:100%;">
				<div style="position:absolute; top:8px; left:8px; z-index:20; min-width:24px; height:24px; line-height:24px; padding:0 8px; border-radius:12px; background:rgba(0,0,0,0.72); color:#fff; font-size:12px; font-weight:bold;">
					1
				</div>
				<img src="getImage/html_${menuIdx}" width="100%" />
			</div>
			<util:changeImg position="html_${menuIdx}" />
			<div>${htmlServiceContent}</div>
			<util:edit position="html_service_${menuIdx}" content="${htmlServiceContent}"
				richText="true" />
		</div>
	</c:if>
	
	<div id="gridview" class="${span}"
		style="margin-top: 10px; padding:20px; background:#${background_subpage}; opacity:${subpage_opacity}; border-radius: 8px;">
		
		<div style="margin-bottom: ${show_1_TextObject}px;">${subpageContent}</div>
		<util:edit position="service_${menuIdx}_title" content="${subpageContent}" richText="true" />
		<br/>
		
		<div class="row" style="margin-left:${service_margin_left}px; margin-right: ${service_margin_right}px; margin-top: ${show_4_Object}px; margin-bottom: ${show_4_Object}px">
			<c:forEach var="i" begin="1" end="${serviceAmount}" step="1">
				<div class="col-xs-${textmenu_number_xs} col-sm-${textmenu_number_sm} col-md-${textmenu_number_md} col-lg-${textmenu_number_lg}" 
				style="text-align: center; display: inline-block; vertical-align: top; height:${service_height}px">
					
			  		<c:set var="opacity" value="1"/>
			        <c:if test="${not empty visibleStatusList and visibleStatusList[i-1] eq '' }" >
			  			<c:set var="opacity" value="0.1"/>
			        </c:if>
			        
					<c:if test="${not empty descriptions[i-1] and 'true' eq showDescriptionsOnTop and user_role ne '[ROLE_ADMIN]'}" >
			          	<div id="des-${menuIdx}_${i}" align="center" style="opacity:${opacity}; text-align: center;">${descriptions[i-1]}</div> 
			          	<util:edit position="service_${menuIdx}_${i}_description" content="${descriptions[i-1]}" richText="true"/>
			        </c:if>
			        <img src="getImage/html_${menuIdx}" width="100%"/>
					<c:if test="${not empty descriptions[i-1] and 'true' ne showDescriptionsOnTop or user_role == '[ROLE_ADMIN]'}" >
			          	<div id="des-${menuIdx}_${i}" align="center" style="opacity:${opacity}; text-align: center;">${descriptions[i-1]}</div> 
			          	<util:edit position="service_${menuIdx}_${i}_description" content="${descriptions[i-1]}" richText="true"/>
			        </c:if>
            <c:if test="${'true' eq show_service_cBox and not isAboveManager}">
					    <c:set var="visibility" value="${empty visibleStatusList[i-1] or visibleStatusList[i-1] eq 1 ? 'visible' : 'hidden'}" />
				    	<c:choose>
				    	  <c:when test = "${support_times ne true or isPrinter}">
					    	<c:choose>
								<c:when test="${not empty visibleStatusList and not empty visibleStatusList[i-1]}">
									<input id="check-${menuIdx}_${i}" type="checkbox" name="${menuIdx}_${i}" style="width:80px; height:20px; visibility:${visibility};"
									 checked="checked" onclick="javascript:updateStatus('${menuIdx}_${i}',0,'${user_role}','check, ${tax_rate})" />
						       	</c:when>
						        <c:otherwise>
									<input id="check-${menuIdx}_${i}" type="checkbox" name="${menuIdx}_${i}" style="width:80px; height:20px; visibility:${visibility}; "
									 onclick="javascript:updateStatus('${menuIdx}_${i}',0,'${user_role}','check', ${tax_rate})" />
						        </c:otherwise>
					  		</c:choose>
				  		  </c:when>
				  		  <c:otherwise>
					  		<span style="display: inline-flex; align-items: center; border: 1px solid #${color_operator};
							border-radius: ${statusbar_border_radius}px; padding: 2px; font-size: ${fontsize_operator}px; color:#${color_operator}">
					  			<c:set var="aboveTwo" value="${not empty visibleStatusList and not empty visibleStatusList[i-1] and visibleStatusList[i-1] != '1'}" />
					  			
								<a id="decreaser-${menuIdx}_${i}" onclick="javascript:updateStatus('${menuIdx}_${i}',0,'${user_role}','down1', ${tax_rate})" 
								style="color:#${color_operator}; border-radius:${statusbar_border_radius}px; background:#${background_operator}; display:inline-block; width:${touchButtonWidth}px">&#160;- &#160;</a>
					     		
					     		<input id="txt-${menuIdx}_${i}" type="text" name="${menuIdx}_${i}" value="${visibleStatusList[i-1] == null ? '0' : visibleStatusList[i-1]}" readonly="readonly" 
								style="padding:2px; text-align:center; width:40px; border-style:none; background:none; font-size: ${fontsize_num}px;"/>
							 	
							 	<a id="increaser-${menuIdx}_${i}" onclick="javascript:updateStatus('${menuIdx}_${i}',0,'${user_role}','up1', ${tax_rate})"
							 	style="color:#${color_operator}; border-radius:${statusbar_border_radius}px; background:#${background_operator}; display:inline-block; width:${touchButtonWidth}px">&#160;+&#160;</a>
						 	</span>
				    	  </c:otherwise>
				    	</c:choose>
				  		<c:if test="${'true'==support_note}">
				  		
					  		<spring:url value="/resources/images/note.png" var="note_img_url" />
							<img id="note-${menuIdx}_${i}" alt="note" src="${note_img_url}"
							 style="padding-bottom: 10px;  cursor:pointer; 
							 visibility:${not empty visibleStatusList and visibleStatusList[i-1] >= '1'?'visible':'hidden'}"  
							onclick="javascript:showNote('${menuIdx}_${i}',-1)"/>
				    	</c:if>
				    </c:if>
				</div>
			</c:forEach>
		</div>
	</div>
	
    <util:showQtAdjuster />
	<util:checkOut />
	<util:showNote allowedLevel="[ROLE_MANAGER]"/>
	
</div>

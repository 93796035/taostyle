<div xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:util="urn:jsptagdir:/WEB-INF/tags/util"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions" version="2.0">
	<jsp:directive.page contentType="text/html;charset=UTF-8" />
	<jsp:output omit-xml-declaration="yes" />

	<spring:message var="title" code="welcome_titlepane"
		arguments="${app_name}" htmlEscape="false" />

	<!-- the varibles for document.wirte(...) javascirps -->
	<spring:message var="linkA_JIMG" code="linkA_JIMG" htmlEscape="false" />
	<spring:message var="imgTag" code="imgTag" htmlEscape="false" />
	<spring:message var="anglebrackets_left" code="anglebrackets_left"
		htmlEscape="false" />
	<spring:message var="ahref" code="ahref" htmlEscape="false" />
	<spring:message var="endOfLink" code="endOfLink" htmlEscape="false" />
	<spring:message var="theEnd" code="theEnd" htmlEscape="false" />
	<spring:message var="liElementOn" code="liElementOn" htmlEscape="false" />
	<spring:message var="liElement1" code="liElement1" htmlEscape="false" />
	<spring:message var="liElement2" code="liElement2" htmlEscape="false" />

	<!-- dosen't work, because absolute path doesn't work even for local tomcat! <spring:url var="imgBasePath" value="${imgBasePath}" /> -->
	<!-- can not replace the imaged insite Root.war, and can not allow it lost when update the application.  <spring:url var="imgBasePath" value="/resources/images/" /> -->
	<!-- Main -->
	<c:if test="${not empty show_MainSlider}">
		<div id="myCarousel" class="carousel slide"
			style="margin-bottom: ${show_MainSlider}px;">
			<div class="carousel-inner">
				<div class="item active" align="center">
					<img src="getImage/slide_superBig_1" />
					<c:if test="${not empty showTextOnSlider}">
						<div class="carousel-caption" style="display: inline-block; max-width:${showTextOnSlider_w}px; left:${showTextOnSlider}px; top:${showTextOnSlider_y}px;
						 background-color:rgba(${slider_text_bg}); padding-left:20px; padding-right:20px;">
							${text_on_slid[0]}
						</div>
						<script type="text/javascript"><jsp:text><![CDATA[
						var container = document.querySelector("#myCarousel > div");
						var elements = [];
						for (var sliderIndex = 1; sliderIndex < ${slide_superBig_amount}; sliderIndex++) {
							elements.push(document.querySelector("#myCarousel > div > div:nth-child(" + sliderIndex + ") > div:nth-child(2)"));
						}
						var speed = 0.3;
						var position = 0;
						var scrollHeight = 0;
						var activeIndex = 0;
						function moveElements() {
							if (elements[activeIndex] != null && elements[activeIndex].scrollHeight > container.offsetHeight) {
								var parentClass = elements[activeIndex].parentNode.classList;
								if (parentClass[1] === 'active') {
									position -= speed;
									if (scrollHeight === 0) {
										scrollHeight = elements[activeIndex].scrollHeight;
									}
									if (position < -scrollHeight) {
										position = container.offsetHeight;
									}
									for (var j = 0; j < elements.length; j++) {
										if (elements[j] != null) {
											elements[j].style.top = position + 'px';
										}
									}
								}
							} else {
								activeIndex++;
								if (activeIndex >= ${slide_superBig_amount}) {
									activeIndex = 0;
								}
								elements[activeIndex] = document.querySelector("#myCarousel > div > div:nth-child(" + (activeIndex + 1) + ") > div:nth-child(2)");
							}
							requestAnimationFrame(moveElements);
						}
						moveElements();
						]]></jsp:text></script>
					</c:if>
					<div class="carousel-caption" style="display: inline-block;">
						<c:if test="${not empty showTextOnSlider}">
							<util:edit position="text_on_slid_1" content="${text_on_slid[0]}" richText="true" />
						</c:if>
						<util:changeImg position="slide_superBig_1"/>
					</div>
				</div>
				<c:if test="${user_role == '[ROLE_ADMIN]'}">
					<c:set var="slide_superBig_amount" value="${slide_superBig_amount + 1}" />
				</c:if>
				<c:forEach var="i" begin="2" end="${slide_superBig_amount}" step="1">
					<div class="item" align="center">
						<img src="getImage/slide_superBig_${i}" />
						<c:if test="${not empty showTextOnSlider}">
							<div class="carousel-caption" style="display: inline-block; left:${showTextOnSlider}px; top:${showTextOnSlider_y}px;
							 max-width:${showTextOnSlider_w}px; background-color:rgba(${slider_text_bg}); padding-left:20px; padding-right:20px;">
								${text_on_slid[i-1]}
							</div>
						</c:if>
						<div class="carousel-caption" style="display: inline-block;">
							<c:if test="${not empty showTextOnSlider}">
								<util:edit position="text_on_slid_${i}" content="${text_on_slid[i-1]}" richText="true" />
							</c:if>
							<util:changeImg position="slide_superBig_${i}"/>
						</div>
					</div>
				</c:forEach>
			</div>

			<c:if
				test="${slide_superBig_amount > 1 or user_role == '[ROLE_ADMIN]'}">
				<a class="left carousel-control" href="#myCarousel"
					data-slide="prev">
					<!-- DO NOT REMOVE This comments -->
				</a>
				<a class="right carousel-control" href="#myCarousel"
					data-slide="next">
					<!-- DO NOT REMOVE This comments -->
				</a>
			</c:if>
		</div>
	</c:if>

	<c:if test="${not empty show_SmallSlider}">
		<table

					src="../images/${gift}" /></td>
				<td></td>
				<td valign="top" align="center" width="100%">
					<div class="promotion">
						<br />
						<div class="STYLE3">Special</div>
						<div>coming soon...</div>
					</div>
				</td>
			</tr>
		</table>

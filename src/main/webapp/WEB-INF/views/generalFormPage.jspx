<div xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:fn="http://java.sun.com/jsp/jstl/functions"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:util="urn:jsptagdir:/WEB-INF/tags/util"
	xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html;charset=UTF-8" />
	<jsp:output omit-xml-declaration="yes" />

	<!-- don't display by default -->
	<c:set value=" col-xs-12 col-sm-12 col-md-12 col-lg-12" var="span" />
	<c:set value="0px" var="leftmargin" />

	<!-- if have menu, then display-->
	<c:if test="${not empty subMenu and 'true' eq leftbar_fixed}">
		<c:set value=" col-xs-${service_width_xs} col-sm-${service_width_sm} col-md-${service_width_md} col-lg-${service_width_lg} col-xl-${service_width_xl}
		 col-sm-offset-${12-service_width_sm} col-md-offset-${12-service_width_md} col-lg-offset-${12-service_width_lg} col-xl-offset-${12-service_width_xl}" var="span" />
		<c:set value="20px" var="leftmargin" />
	</c:if>

	<c:set var="isAboveManager"  value="false" />
	<c:if test="${user_role == '[ROLE_ADMIN]'  or user_role == '[ROLE_MANAGER]'}">
		<c:set var="isAboveManager"  value="true" />
	</c:if>
	
  	<c:set var="isAboveEmployee"  value="false" />
	<c:if test="${isAboveManager or user_role == '[ROLE_EMPLOYEE]'}">
		<c:set var="isAboveEmployee"  value="true" />
	</c:if>
	
	<!-- Main Content -->
	<c:if test="${user_role == '[ROLE_ADMIN]'}" >
		<div class="content ${span}" style="color:#${background_foot}; margin-left:${leftmargin}; padding:20px; 
		background:#${background_subpage}; opacity:${subpage_opacity}; float:right">
			<img src="getImage/html_${menuIdx}" width="100%" />
			<util:changeImg position="html_${menuIdx}" />
			
			<div>${htmlServiceContent}</div>
			<util:edit position="html_service_${menuIdx}" content="${htmlServiceContent}"
				richText="true" />
		</div>
	</c:if>
	
	<div id="gridview" class="${span}" style="margin-top: 10px; padding:20px; background:#${background_subpage}; opacity:${subpage_opacity}; border-radius: 8px;">
		<div style="margin-bottom: ${show_1_TextObject}px;">
			${subpageContent}
		</div>
		<util:edit position="service_${menuIdx}_title" content="${subpageContent}" richText="true" />
		<br/>

		<form id="orderForm" action="${submitPath}" method="post">
		<div class="row" style="margin-left:${service_margin_left}px; margin-right: ${service_margin_right}px; margin-top: ${show_4_Object}px; margin-bottom: ${show_4_Object}px">
			<div align="left" style="margin-left: ${margin_left}px">

				<c:forEach var="i" begin="1" end="${questionAmount}" step="1">
					<div class="col-xs-${textmenu_number_xs} col-sm-${textmenu_number_sm} col-md-${textmenu_number_md} col-lg-${textmenu_number_lg}"
					style="display: inline-block; vertical-align: top;">

				        <img src="getImage/html_${menuIdx}" width="100%"/>
				        <div id="des-${menuIdx}_${i}" align="left" style="opacity:${opacity}">
				        	<span>
				        		${questions[i-1]}
				        		<input id="form${i-1}" placeholder="${formTypes[i-1]}" name="${formNames[i-1]}" style="border: 1px solid #bebdaa; border-radius: 5px; color: #86856f; font: italic 105%/110% 'Times New Roman', Times, serif; padding: 4px; margin: 10px; margin-left: 0px; transition: all 0.7s ease 0s; width: 240px;" />
							</span>
						</div>
				        <util:edit position="service_${menuIdx}_${i}_description" content="${questions[i]}" richText="true"/>

					</div>
				</c:forEach>
			</div>
		</div>

			<c:if test="${not empty submitPath}">
				<div class="row" style="margin-top: 20px; text-align: center;">
					<button type="submit" class="btn btn-primary" onclick="return confirmSubmission();">
						Submit
					</button>
				</div>
			</c:if>
		</form>
		<script>
			function confirmSubmission() {
				alert("Application submitted, click OK to close the session.");
				return "true";
			}
		</script>

</div>
	
</div>
			// 		note.style.visibility = 'hidden';
			// 	}
			// }
			//
			// //save a copy into the session. the selectedItems in session is not only helped to displaying page with an "already selected" status,
			// //but also used to calculate toltal price. when user switch between other web site in sharethegoodones.com, the selectedItem be clean up.
			// $.ajax({
			// 	headers: "Accept=application/json",
			// 	type: "POST",
			// 	url: "createOrder/"+imageKey,
			// 	data:"change=" + change,
			// 	async:true,
			// 	success:function(textContent){
			// 		//location.reload();
			// 		if(textField != null){
			// 			textField.value = change == 'up1' ? selected + 1 : selected -1;
			// 		}
			//
			// 		var selectedItem = document.getElementById("selectedItem"); //who will need this guy?
			// 		if(selectedItem != null){
			// 			var currentValue = Number(selectedItem.innerText); // 将文本内容转换为数字
			// 			selectedItem.innerText = (change == 'up1' || (curObj != null &amp;&amp; curObj.checked)) ? currentValue + 1 : currentValue - 1;
			// 		}

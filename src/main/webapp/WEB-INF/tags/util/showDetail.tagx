			// 	}
			// });
		}
		function showToast(message) {
			let toast = document.createElement("div");
			toast.textContent = message;
			toast.style.position = "fixed";
			toast.style.bottom = "20px";
			toast.style.right = "20px";
			toast.style.background = "rgba(0, 0, 0, 0.8)";
			toast.style.color = "white";
			toast.style.padding = "10px 20px";
			toast.style.borderRadius = "5px";
			toast.style.zIndex = "9999";
			document.body.appendChild(toast);

			setTimeout(() => {
				toast.style.opacity = "0";
				setTimeout(() => document.body.removeChild(toast), 500);
			}, 2000);
		}

		function resetMainImageZoom() {
			let mainImage = document.getElementById("mainImage");
			if (!mainImage) {
				return;
			}
			mainImage.style.transform = "scale(1)";
			mainImage.style.transformOrigin = "center center";
		}

		function bindMainImageZoom() {
			let imageDisplay = document.getElementById("imageDisplay");
			let mainImage = document.getElementById("mainImage");

			if (!imageDisplay || !mainImage) {
				return;
			}

			imageDisplay.onmousemove = function(e) {
				let rect = imageDisplay.getBoundingClientRect();
				let x = ((e.clientX - rect.left) / rect.width) * 100;
				let y = ((e.clientY - rect.top) / rect.height) * 100;

				if (x < 0) x = 0;
				if (x > 100) x = 100;
				if (y < 0) y = 0;
				if (y > 100) y = 100;

				mainImage.style.transformOrigin = x + "% " + y + "%";
				mainImage.style.transform = "scale(2)";
			};

			imageDisplay.onmouseleave = function() {
				resetMainImageZoom();
			};
		}

		function updateMainImage(imageSrc) {
			let mainImage = document.getElementById("mainImage");
			if (!mainImage) {
				return;
			}
			mainImage.src = imageSrc;
			resetMainImageZoom();
		}

		function showDetail(value) {
			$.ajax({
				headers: { "Accept": "application/json" },
				type: "GET",
				url: "serviceDetailJSon/" + value,
				async: false,
				success: function(response) {
					let serviceName = response.serviceName;
					let serviceDescription = response.serviceDescription;
					let servicePrice = response.servicePrice ? "$" + response.servicePrice : "";
					let imageList = response.imageList;
					let optionName = response.serviceOptionName;
					// **更新文本内容**
					if (optionName) {
						document.getElementById("service_option_name").innerHTML = optionName;
					}
					if(response.serviceOptions) {
						let options = response.serviceOptions.split(';');
						// **动态生成尺寸选项**
						let optionContainer = document.getElementById("service_options");
						optionContainer.innerHTML = "";
						options.forEach((option, index) => {
							let input = document.createElement("input");
							input.type = "radio";
							input.id = "option-" + option;
							input.name = "option";
							input.value = option;

							let label = document.createElement("label");
							label.setAttribute("for", "option-" + option);
							label.style.color = `#${foreground_menu}`; // 动态设置颜色
							label.textContent = option;

							optionContainer.appendChild(input);
							optionContainer.appendChild(label);
						});
					}
					if(document.getElementById('txtNumber') != null){
						document.getElementById('txtNumber').value = 0;
					}
					document.getElementById("detail_service_name").innerHTML = serviceName.content;
					document.getElementById("detail_service_description").innerHTML = serviceDescription.content;

					let serviceBottomDescription = response.serviceBottomDescription;
					if (document.getElementById("detail_service_bottom") !== null) {
						document.getElementById("detail_service_bottom").innerHTML =
								(serviceBottomDescription && serviceBottomDescription.content) ? serviceBottomDescription.content : "";
					}

					if (document.getElementById("serviceItemIdx") !== null) {
						document.getElementById("serviceItemIdx").value = serviceDescription.posInPage;
					}
					if (document.getElementById("serviceDetailTxt") !== null) {
						document.getElementById("serviceDetailTxt").value = serviceDescription.posInPage;
					}
					if (document.getElementById("serviceDetailBottomTxtForm") !== null) {
						if (serviceBottomDescription && serviceBottomDescription.posInPage) {
							document.getElementById("serviceDetailBottomTxtForm").value = serviceBottomDescription.posInPage;
						} else {
							document.getElementById("serviceDetailBottomTxtForm").value = serviceDescription.posInPage + "_bottom";
						}
					}
					if(document.getElementById("detail_service_price") !== null) {
						document.getElementById("detail_service_price").innerHTML = servicePrice;
					}
					let metricsBox = document.getElementById("detail_service_metrics");
					if(metricsBox !== null) {
						if (response.showManagerMetrics) {
							let metrics = [];
							if (response.serviceCost) metrics.push("Cost: $" + response.serviceCost);
							if (response.serviceStock) metrics.push("Stock In: " + response.serviceStock);
							if (response.serviceWeeklySalesQty) metrics.push("WQty: " + response.serviceWeeklySalesQty);
							if (response.serviceMonthlySalesQty) metrics.push("MQty: " + response.serviceMonthlySalesQty);
							metricsBox.innerHTML = metrics.join("<br/>");
							metricsBox.style.display = metrics.length > 0 ? "block" : "none";
						} else {
							metricsBox.innerHTML = "";
							metricsBox.style.display = "none";
						}
					}
					// **更新图片**
					let thumContainer = document.getElementById("thumContainer");
					let mainImage = document.getElementById("mainImage");

					// **清空旧的 thumContainer 内容**
					thumContainer.innerHTML = '';

					// **如果小图片数量大于 1，显示缩略图区域**
					if (imageList.length > 1) {
						thumContainer.style.display = "flex";

						// **循环添加所有缩略图**
						imageList.forEach((img, index) => {
							let thumImg = document.createElement("img");
							thumImg.src = "getImage/" + img.thum;
							thumImg.classList.add("thumImg");
							thumImg.style.width = "80px";
							thumImg.style.height = "80px";
							thumImg.style.cursor = "pointer";
							thumImg.style.objectFit = "cover";
							thumImg.style.borderRadius = "5px";
							thumImg.style.margin = "5px";

							// **点击缩略图更新大图**
							thumImg.onclick = function () {
								updateMainImage("getImage/" + img.big);
							};

							// **将缩略图添加到容器**
							thumContainer.appendChild(thumImg);
						});
					} else {
						// **只有一张图片，隐藏缩略图区域**
						thumContainer.style.display = "none";
					}

					// **默认显示第一张图的大图**
					if (imageList.length > 0) {
						mainImage.src = "getImage/" + imageList[0].big;
						resetMainImageZoom();
					}

					bindMainImageZoom();

					// **显示模态框**
					$("#luanchDetailDlg").click();
				}
			});
		}
		function closeDetail() {
			let popup = document.getElementById('windowTitleDialog');
			if (popup) {
				popup.style.display = "none";
			}
			let modalBackdrop = document.querySelector(".modal-backdrop");
			if (modalBackdrop) {
				modalBackdrop.parentNode.removeChild(modalBackdrop);
			}

			// 确保页面可以正常交互
			document.body.classList.remove("modal-open");
			document.body.style.overflow = "auto";
		}
		]]>
	</script>

</jsp:root>
